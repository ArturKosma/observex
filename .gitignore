# Build output (and anything built into the project folder: observex.exe, its DLLs, test exes)
build/
out/
/*.exe
/*.dll
/*.pdb

# The app's settings and recordings (screen images, gigabytes per hour)
/observex.cfg
/recordings/
# The log (the profiles in /brains/, state trees and skills, are kept in git)
/observex.log
/observex-trace.log
# What a crash leaves (engine/CrashLog: minidumps)
/crashes/

# IDEs
.vs/
.vscode/
.idea/
*.user
CMakeUserPresets.json

# Saved ImGui window layout
imgui.ini

# Python bytecode
__pycache__/

# Training tool: its Python environment.
/tools/train/.venv/
# The models: the live ones are kept in git (model.json, model.onnx, and model.pth through Git LFS, see
# .gitattributes; models/ui and models/geodata whole). Left out: TensorRT engines (made again for the GPU on first
# use), the datasets and training runs (made again from the recordings by train.py), and older models kept as backups.
/models/**/*.engine
/models/*/dataset/
/models/*/training/
/models/*/previous-*/
/models/*/tight-*/
/models/*/before-*/

# TensorRT and the CUDA runtime, downloaded by cmake/TensorRT.cmake (about 2 GB).
/deps/
